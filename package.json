{
  "name": "balbul-desktop",
  "version": "1.0.14",
  "description": "balBul - asisten desktop pixel art untuk pengingat dan to-do list",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:mac": "electron-builder --mac dmg --arm64 --x64"
  },
  "author": "bulbule",
  "license": "MIT",
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "com.balbul.desktop",
    "productName": "balBul",
    "directories": {
      "output": "dist"
    },
    "compression": "maximum",
    "asar": true,
    "files": [
      "src/**/*",
      "assets/**/*",
      "web/share-card.js",
      "package.json"
    ],
    "win": {
      "extraResources": [
        {
          "from": "resources/cloudflared/win-x64",
          "to": "cloudflared/win-x64"
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerSidebar": "build/installerSidebar.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "balBul"
    },
    "artifactName": "balBul-Setup.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "bulbule",
        "repo": "balbul-desktop",
        "releaseType": "release"
      }
    ],
    "mac": {
      "extraResources": [
        {
          "from": "resources/cloudflared/mac-arm64",
          "to": "cloudflared/mac-arm64"
        },
        {
          "from": "resources/cloudflared/mac-x64",
          "to": "cloudflared/mac-x64"
        }
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/icon-mac.png",
      "identity": null,
      "artifactName": "balBul-${version}-mac-${arch}.${ext}"
    },
    "afterPack": "scripts/adhoc-sign.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.2",
    "electron-updater": "^6.6.2",
    "qrcode": "1.5.4"
  }
}
